{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hiukka-hv/unityarchitect-sdk-catalog/schemas/firebase-catalog.schema.json",
  "title": "Firebase Unity SDK catalog",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "provider",
    "latestVersion",
    "recommendedVersion",
    "releases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../schemas/firebase-catalog.schema.json"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "provider": {
      "type": "string",
      "const": "firebase"
    },
    "latestVersion": {
      "$ref": "#/$defs/version"
    },
    "recommendedVersion": {
      "$ref": "#/$defs/version"
    },
    "releases": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[0-9]+\\.[0-9]+\\.[0-9]+$": {
          "$ref": "#/$defs/release"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "dependencyMap": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(?:[.-][a-z0-9]+)+$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "package": {
      "type": "object",
      "required": [
        "name",
        "archiveUrl",
        "sha256",
        "dependencies"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^com\\.google\\.[a-z0-9.-]+$"
        },
        "archiveUrl": {
          "type": "string",
          "pattern": "^https://dl\\.google\\.com/games/registry/unity/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "$ref": "#/$defs/dependencyMap"
        }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": [
        "source",
        "packages"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^https://github\\.com/firebase/firebase-unity-sdk/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
